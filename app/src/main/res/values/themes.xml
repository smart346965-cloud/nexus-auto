<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 👑 الثيم الأساسي لـ TWA (مضيء دائماً Light Only) -->
    <style name="Base.Theme.MyTwasmart" parent="Theme.Material3.Light.NoActionBar">
        <!-- توحيد ألوان النظام مع المتجر -->
        <item name="android:statusBarColor">@color/status_bar_color</item>
        <item name="android:navigationBarColor">@color/navigation_bar_color</item>

        <!-- 👑 ذكاء الأيقونات: يقرأ القيمة من ملف إعدادات العميل -->
        <item name="android:windowLightStatusBar">@bool/is_light_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/is_light_bg</item>

        <!-- لون خلفية الشاشة قبل أن يفتح كروم -->
        <item name="android:windowBackground">@color/splash_bg_color</item>
    </style>

    <style name="Theme.MyTwasmart" parent="Base.Theme.MyTwasmart" />
</resources>